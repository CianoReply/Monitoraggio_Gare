# Copia questo file in .env e compila i valori sul tuo computer.
# .env NON va mai versionato né letto da Claude (vedi CLAUDE.md, sezione Vincoli).
# Altre variabili verranno aggiunte dai task che le introducono (es. T0.7 per Docker).

# Database (PostgreSQL in sviluppo, SQLite nei test) – valori definiti in T0.7
DATABASE_URL=

# API di ricerca TED (nessuna chiave; vedi docs/TED_API_NOTES.md). Vuoto = https://api.ted.europa.eu/v3/notices/search
TED_API_URL=

# Prefissi CPV IT usati nella query a TED (T1.2), separati da virgola. Vuoto = 72,48,302,324,642
TED_CPV_PREFIXES=

# Cartella dei documenti di gara scaricati (T2.4)
DOCUMENTS_DIR=
