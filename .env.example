# Copia questo file in .env e compila i valori sul tuo computer.
# .env NON va mai versionato né letto da Claude (vedi CLAUDE.md, sezione Vincoli).
# Con `docker compose up` il compose imposta da solo DATABASE_URL a partire dai valori POSTGRES_*.

# Database (PostgreSQL in sviluppo, SQLite nei test).
# Fuori da Docker: DATABASE_URL=postgresql+psycopg://utente:password@localhost:5432/radar
# (o sqlite:///radar.db per prove veloci).
DATABASE_URL=

# Servizio PostgreSQL di docker-compose.yml. Vuoto = predefiniti di sviluppo (radar / radar_dev / radar).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Porte pubblicate sul proprio computer da docker compose. Vuoto = 5432 e 8000.
POSTGRES_PORT=
API_PORT=

# Origini del frontend ammesse dal CORS dell'API, separate da virgola.
# Vuoto = http://localhost:3000,http://localhost:5173 (indirizzo reale del frontend DA VERIFICARE)
CORS_ORIGINS=

# API di ricerca TED (nessuna chiave; vedi docs/TED_API_NOTES.md). Vuoto = https://api.ted.europa.eu/v3/notices/search
TED_API_URL=

# Prefissi CPV IT usati nella query a TED (T1.2), separati da virgola. Vuoto = 72,48,302,324,642
TED_CPV_PREFIXES=

# Cartella dei documenti di gara scaricati (T2.4)
DOCUMENTS_DIR=
