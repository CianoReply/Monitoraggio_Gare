{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report della Skill analisi-gara (T2.5)",
  "description": "Formato del report prodotto dalla Skill e caricato con POST /tenders/{id}/report. Deve coincidere con ReportCreate e FieldReview di docs/API_CONTRACT.yaml (lo verifica un test). Il codice valida con i modelli pydantic di backend/domain/reports.py, senza la libreria jsonschema.",
  "$ref": "#/definitions/ReportCreate",
  "definitions": {
    "ReportCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "fields"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "source_doc", "is_critical"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1},
              "source_doc": {"type": "string", "minLength": 1},
              "source_page": {"type": ["integer", "null"], "minimum": 1},
              "is_critical": {"type": "boolean"}
            }
          }
        }
      }
    },
    "FieldReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reviewer"],
      "if": {
        "properties": {"action": {"const": "correct"}},
        "required": ["action"]
      },
      "then": {"required": ["value"]},
      "properties": {
        "action": {"type": "string", "enum": ["confirm", "correct"]},
        "value": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1}
      }
    }
  }
}
